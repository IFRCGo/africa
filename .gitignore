# Python
__pycache__/
*.pyc
.gitignore
# Secrets. NOTHING matching .env is ever committed - not .env, and not any
# .env.something variant, however it is named. The published template is
# "env.example" (no leading dot), which contains placeholders only.
.env
.env.*
.env.example
# Same file before it is renamed to .env, and any stray copy of it.
credentials

# Django
# Community Centered Humanitarian Analysis Platform/staticfiles/
# Documents uploaded through Admin. /app is bind-mounted to this folder, so
# without this every uploaded PDF lands in the working tree waiting to be
# committed by accident.
# Community Centered Humanitarian Analysis Platform/media/
Community_Centered_Humanitarian_Analysis_Documentation.docx
AGENTS.md
CLAUDE.md
# Subagent-driven-development scratch: ledgers, briefs, review packages.
# Recreated per plan run; the git history is the real record.
.superpowers/

# A filled-in .env under another name. `vvv` is the staging copy you rename to
# .env once the passwords and API keys are pasted in - it holds real secrets
# from that moment on, so it is ignored exactly as .env is.
vv
vvv
