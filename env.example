# ---------------------------------------------------------------------------
# Sudan & Neighbouring countries - Community Centered Humanitarian Analysis
#
# TEMPLATE. Copy it to ".env" next to docker-compose.yml and change the three
# passwords. ".env" is git-ignored; this file is the committed example, so it
# must never contain a real password.
#
#     Copy-Item env.example .env         # macOS/Linux: cp env.example .env
#
# Rules Compose applies when it reads this file:
#   * no quotes needed, and no spaces around the "="
#   * "#" starts a comment, even in the middle of a line
#   * "$" starts a variable reference
# So keep passwords to letters, digits, "-" and "_".
#
# Every setting is explained in chapter 4 of
# docs/Community_Centered_Humanitarian_Analysis_Documentation.docx
# ---------------------------------------------------------------------------

# --------------------------------------------------------------- PostgreSQL
# The database that stores every document, figure, flow and event.
# POSTGRES_DB is baked into the volume the first time the stack starts.
# Changing it later does NOT rename the existing database - see "Rotating the
# passwords" in README.md, which uses ALTER DATABASE / ALTER USER instead.
POSTGRES_DB=sudan_neighbouring_pop_movement
POSTGRES_USER=sudan
POSTGRES_PASSWORD=change-me-a-long-random-string

# --- Using a PostgreSQL server you already have ----------------------------
# Leave the next two commented out and the app uses the "db" container that
# ships with this project - nothing else to do.
#
# To point at your own database instead, uncomment them and fill in your
# details. The application does not care where PostgreSQL lives; it only needs
# these five values, and it will create its own tables on first start
# (docker compose exec web python manage.py migrate).
#
#   * a server on another machine   POSTGRES_HOST=db.example.org
#   * a managed/cloud database      POSTGRES_HOST=something.rds.amazonaws.com
#   * PostgreSQL on THIS machine, outside Docker:
#       POSTGRES_HOST=host.docker.internal      <- not "localhost": inside a
#       container "localhost" means the container itself, not your computer.
#       That name works on Docker Desktop (Windows and macOS). On Linux with
#       plain Docker Engine, also add this to the "web" service in
#       docker-compose.yml:   extra_hosts: ["host.docker.internal:host-gateway"]
#
# When you use your own server the bundled "db" container is simply unused.
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# --------------------------------------------------------------------- Django
# Signs cookies and sessions. Generate a fresh one; changing it later is safe
# and only logs out whoever is currently signed in.
DJANGO_SECRET_KEY=change-me-a-long-random-string

# 1 while you are working locally, 0 for anything shared.
DJANGO_DEBUG=1

# "*" is fine on your own machine. On a shared host, list the real hostnames.
DJANGO_ALLOWED_HOSTS=*

# Only needed when the site is served over https behind a real domain, e.g.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tracker.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=

# Where the "open the dashboard" links point.
DASHBOARD_URL=/

# Time zone used for report dates and log timestamps.
TZ=UTC

# Optional in-container insight extraction. Leave unset to run extraction
# with an agent on the host instead. For a local model, point LLM_BASE_URL
# at http://host.docker.internal:11434/v1 and set LLM_PROVIDER to
# openai_compatible.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5
# LLM_BASE_URL=
# LLM_API_KEY=

# ------------------------------------------------------- the /admin/ login
# Read ONLY when the database has no superuser yet - on the very first start.
# Afterwards Django keeps its own password hash, and the way to change it is
#     docker compose exec web python manage.py changepassword admin
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.org
DJANGO_SUPERUSER_PASSWORD=change-me-a-long-random-string

# -------------------------------------------------------------------- pgAdmin
# The login for http://localhost:5050/. Like PostgreSQL, pgAdmin stores this
# inside its own volume on first start; rotate it with setup.py update-user
# rather than by editing this file - again, see README.md.
PGADMIN_DEFAULT_EMAIL=admin@example.org
PGADMIN_DEFAULT_PASSWORD=change-me-a-long-random-string

# ---------------------------------------------------------------------- ports
# The port on YOUR machine. Change these if something else already uses them;
# the ports inside Docker never change.
WEB_HOST_PORT=2026
POSTGRES_HOST_PORT=5432
PGADMIN_HOST_PORT=5050

# ------------------------------------------------------------ paths in Docker
# All four have working defaults in docker-compose.yml. Uncomment one only if
# you have moved something. These are paths INSIDE the container:
#   /work  is the parent "SUDAN Ops" folder, mounted read-only
#   /app   is the "Community Centered Humanitarian Analysis Platform" folder
#
# Where the pipeline looks for the source PDFs.
# SOURCE_ROOT=/work
#
# Where the pipeline writes the JSON the map reads. It lives inside Django,
# so the dashboard serves its own data and nothing sits outside the app.
# DASHBOARD_DATA_DIR=/app/dashboard/data
#
# Where the MCP pulls (HDX, IPC, FEWS NET, UNHCR) are cached. They are refreshed
# by an analyst in Claude Code, not by the app - see data_pipeline/README.md.
# MCP_CACHE_DIR=/app/data_pipeline/mcp_cache
#
# The workbook holding the biweekly refugee series per host country.
# POP_MOVEMENT_XLSX=/work/neighbouring countries Pop movement data.xlsx
